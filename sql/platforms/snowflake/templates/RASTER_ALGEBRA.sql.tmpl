    const name = L.snowflakeTableName(t, 'input ' + L.inputRef(i));
    // Column names are only available on a Statement (not on a ResultSet)
    const stmt = snowflake.createStatement({ sqlText: `SELECT * FROM ${name} LIMIT 0` });
    try {
