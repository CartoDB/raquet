    }
    const columns = [];
    for (let c = 1; c <= stmt.getColumnCount(); c++) columns.push(stmt.getColumnName(c));
    inputColumns.push(columns);
    const metadataColumn = columns.find(c => c.toLowerCase() === 'metadata');
    const blockColumn = columns.find(c => c.toLowerCase() === 'block');
    if (!metadataColumn || !blockColumn) {
