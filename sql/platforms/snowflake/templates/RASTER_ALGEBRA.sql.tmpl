/*__RAQUET_ALGEBRA_LIB__*/
const L = raquetAlgebraLib;
const BLOCK_FUNCTION = 'RAQUET_DB.RAQUET.__RASTER_ALGEBRA_BLOCK';

if (!Array.isArray(INPUTS) || INPUTS.length === 0) {
    throw new Error('RASTER_ALGEBRA: at least one input raster is required');
